---
import Layout from '../layouts/Layout.astro';
import { FORMAT_DIRECTORY_GROUPS } from '../data/formats';

const RELEASES_URL = 'https://github.com/alikia2x/BentoZip/releases/latest';
const GITHUB_URL = 'https://github.com/alikia2x/BentoZip';
const ISSUES_URL = 'https://github.com/alikia2x/BentoZip/issues';
---

<Layout>
  <!-- Flush Seamless Sticky Header -->
  <header class="sticky top-0 z-50 h-14 border-b border-black/[0.06] bg-white/85 backdrop-blur-xl">
    <div class="max-w-[1160px] mx-auto h-full px-6 flex items-center justify-between gap-4">
      <a href="#" class="flex items-center gap-2.5 text-[#111214] no-underline shrink-0">
        <img
          src="/images/app-icon.png"
          alt="BentoZip"
          width="26"
          height="26"
          class="w-[26px] h-[26px] rounded-[6px] ring-1 ring-black/[0.06] shadow-[0_1px_3px_rgba(0,0,0,0.10)]"
        />
        <span class="text-[15px] font-semibold tracking-[-0.015em]">BentoZip</span>
      </a>

      <nav aria-label="Primary" class="flex items-center gap-6 sm:gap-7">
        <a
          href="#features"
          class="hidden sm:inline-block text-[13.5px] font-medium text-[#5B5E66] hover:text-[#111214] transition-colors"
        >
          Features
        </a>
        <a
          href="#formats"
          class="hidden sm:inline-block text-[13.5px] font-medium text-[#5B5E66] hover:text-[#111214] transition-colors"
        >
          Formats
        </a>
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[13.5px] font-medium text-[#5B5E66] hover:text-[#111214] transition-colors"
        >
          GitHub
        </a>
        <a
          href={RELEASES_URL}
          data-dmg-link
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center h-8 px-4 rounded-full bg-[#111214] hover:bg-[#2A2C30] text-white text-[13px] font-medium tracking-[-0.01em] transition-colors"
        >
          Download
        </a>
      </nav>
    </div>
  </header>

  <main>
    <!-- 1. Above-the-Fold Full-Bleed Hero -->
    <section class="bg-white">
      <div class="max-w-[1160px] mx-auto px-6 pt-10 pb-8 lg:flex lg:items-end lg:justify-between gap-10">
        <div>
          <h1
            class="font-semibold tracking-[-0.035em] leading-[1.04] text-[#111214]"
            style="font-size: clamp(38px, 4.4vw, 56px);"
          >
            Archives without the mess.
          </h1>
          <p class="mt-3.5 max-w-[520px] text-[17px] leading-[1.5] text-[#5B5E66]">
            Browse inside any archive like Finder, pull out a single file without unpacking the rest, and create clean encrypted archives on macOS.
          </p>
        </div>

        <div class="mt-6 lg:mt-0 shrink-0 flex flex-col lg:items-end gap-2.5">
          <div class="flex flex-wrap items-center gap-4">
            <a
              href={RELEASES_URL}
              data-dmg-link
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center h-10 px-5 rounded-full bg-[#111214] hover:bg-[#2A2C30] text-white text-[14px] font-medium tracking-[-0.01em] transition-colors"
            >
              Download for Mac
            </a>
            <a
              href={GITHUB_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[14px] font-medium text-[#111214] hover:text-[#5B5E66] transition-colors"
            >
              View on GitHub
            </a>
          </div>
          <p class="text-[13px] text-[#7A7E87]">
            Free on macOS 14+ / Apple Silicon &amp; Intel / Signed &amp; Notarized
          </p>
        </div>
      </div>

      <div class="max-w-[1160px] mx-auto px-6 pb-16 sm:pb-20">
        <img
          src="/images/hero-browse.png"
          alt="BentoZip archive browser with Finder hierarchy and Info Inspector"
          width="1200"
          height="750"
          class="w-full h-auto block rounded-[16px] overflow-hidden ring-1 ring-black/[0.07] shadow-[0_24px_64px_rgba(17,18,20,0.09)]"
        />
      </div>
    </section>

    <!-- 2. Band 2: Inspect, Extract & Edit -->
    <section id="features" class="bg-[#F5F5F7] py-20 sm:py-28">
      <div class="max-w-[1160px] mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
          <div class="lg:col-span-5">
            <h2
              class="text-[#111214] font-semibold tracking-[-0.03em] leading-[1.08]"
              style="font-size: clamp(30px, 3.4vw, 40px);"
            >
              Look inside first. Extract only what matters.
            </h2>

            <dl class="mt-7 border-t border-black/[0.07] divide-y divide-black/[0.07]">
              <div class="py-4">
                <dt class="text-[15.5px] font-semibold text-[#111214] tracking-[-0.01em]">
                  Finder Columns &amp; Icon Grid
                </dt>
                <dd class="mt-1.5 text-[14.5px] leading-[1.58] text-[#5B5E66]">
                  Switch between dense directory listings and visual icon grids, press Spacebar for instant Quick Look, or browse images, code, PDFs, and comics inline.
                </dd>
              </div>
              <div class="py-4">
                <dt class="text-[15.5px] font-semibold text-[#111214] tracking-[-0.01em]">
                  Single-File Drag-Out
                </dt>
                <dd class="mt-1.5 text-[14.5px] leading-[1.58] text-[#5B5E66]">
                  Pull one document straight onto your Desktop or any Finder folder without unpacking the surrounding archive.
                </dd>
              </div>
              <div class="py-4">
                <dt class="text-[15.5px] font-semibold text-[#111214] tracking-[-0.01em]">
                  In-Place Archive Editing
                </dt>
                <dd class="mt-1.5 text-[14.5px] leading-[1.58] text-[#5B5E66]">
                  Drop in new files, remove unwanted clutter, or open any item in an external editor and save changes straight back into .zip, .7z, and .tar.
                </dd>
              </div>
              <div class="pt-4">
                <dt class="text-[15.5px] font-semibold text-[#111214] tracking-[-0.01em]">
                  Readable Names Across Languages
                </dt>
                <dd class="mt-1.5 text-[14.5px] leading-[1.58] text-[#5B5E66]">
                  Automatically repairs legacy character encodings on older Windows archives in Chinese, Japanese, and Korean so filenames stay clean.
                </dd>
              </div>
            </dl>
          </div>

          <div class="lg:col-span-7">
            <img
              src="/images/feature-welcome.png"
              alt="BentoZip Welcome window with Recent archives sidebar"
              width="960"
              height="680"
              loading="lazy"
              class="w-full h-auto block rounded-[14px] ring-1 ring-black/[0.07] shadow-[0_20px_50px_rgba(17,18,20,0.08)]"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Band 3: Create, Encrypt & Split -->
    <section class="bg-white py-20 sm:py-28">
      <div class="max-w-[1160px] mx-auto px-6">
        <div class="max-w-[680px]">
          <h2
            class="text-[#111214] font-semibold tracking-[-0.03em] leading-[1.08]"
            style="font-size: clamp(30px, 3.4vw, 42px);"
          >
            Built to pack and protect clean releases.
          </h2>
          <p class="mt-3.5 text-[17px] leading-[1.55] text-[#5B5E66]">
            Choose exact formats, compression strength, exclusion filters, and strong encryption in one focused workspace.
          </p>
        </div>

        <div class="mt-10">
          <img
            src="/images/feature-compress.png"
            alt="BentoZip Compress mode with resizable Archive Settings inspector"
            width="1200"
            height="720"
            loading="lazy"
            class="w-full h-auto block rounded-[16px] ring-1 ring-black/[0.07] shadow-[0_24px_64px_rgba(17,18,20,0.08)]"
          />
        </div>

        <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
          <div class="border-t border-black/[0.08] pt-6">
            <h3 class="text-[16px] font-semibold text-[#111214] tracking-[-0.01em]">
              Reusable Presets &amp; Batch Queue
            </h3>
            <p class="mt-2 text-[14.5px] leading-[1.6] text-[#5B5E66]">
              Save format, compression strength, and skip rules once, then compress or unpack dozens of folders in one pass.
            </p>
          </div>

          <div class="border-t border-black/[0.08] pt-6">
            <h3 class="text-[16px] font-semibold text-[#111214] tracking-[-0.01em]">
              Touch ID Keychain Vault
            </h3>
            <p class="mt-2 text-[14.5px] leading-[1.6] text-[#5B5E66]">
              Save archive passwords safely in your Mac Keychain, generate strong passphrases, and unlock encrypted files with Touch ID.
            </p>
          </div>

          <div class="border-t border-black/[0.08] pt-6">
            <h3 class="text-[16px] font-semibold text-[#111214] tracking-[-0.01em]">
              Multi-Volume Split &amp; Disk Images
            </h3>
            <p class="mt-2 text-[14.5px] leading-[1.6] text-[#5B5E66]">
              Split oversized builds into exact part sizes or package clean .dmg installers alongside .zip, .7z, .tar.zst, and .aar.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Band 4: Quiet Power & macOS Integration -->
    <section class="bg-[#0B0C0F] text-white py-20 sm:py-28">
      <div class="max-w-[1160px] mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
          <div class="lg:col-span-7">
            <img
              src="/images/feature-tasks-dark.png"
              alt="BentoZip floating dark-mode Tasks window showing live speed and progress"
              width="1100"
              height="760"
              loading="lazy"
              class="w-full h-auto block rounded-[14px] ring-1 ring-white/[0.10] shadow-[0_28px_72px_rgba(0,0,0,0.55)]"
            />
          </div>

          <div class="lg:col-span-5">
            <h2
              class="text-white font-semibold tracking-[-0.03em] leading-[1.08]"
              style="font-size: clamp(30px, 3.4vw, 40px);"
            >
              Stay out of your way while heavy jobs run.
            </h2>

            <dl class="mt-7 border-t border-white/[0.10] divide-y divide-white/[0.10]">
              <div class="py-4">
                <dt class="text-[15.5px] font-semibold text-white tracking-[-0.01em]">
                  Floating Tasks Window
                </dt>
                <dd class="mt-1.5 text-[14.5px] leading-[1.58] text-[#A1A4AC]">
                  Track active speed, time remaining, and space saved across every open window without blocking Finder browsing.
                </dd>
              </div>
              <div class="py-4">
                <dt class="text-[15.5px] font-semibold text-white tracking-[-0.01em]">
                  Quick Look &amp; Spotlight in Finder
                </dt>
                <dd class="mt-1.5 text-[14.5px] leading-[1.58] text-[#A1A4AC]">
                  Press Spacebar on any archive in Finder to preview its contents, or search filenames inside archives right from Spotlight.
                </dd>
              </div>
              <div class="py-4">
                <dt class="text-[15.5px] font-semibold text-white tracking-[-0.01em]">
                  Right-Click, Services &amp; Shortcuts
                </dt>
                <dd class="mt-1.5 text-[14.5px] leading-[1.58] text-[#A1A4AC]">
                  Compress or unpack from Finder menus, automate folders in Apple Shortcuts, or use the optional terminal helper when scripting.
                </dd>
              </div>
              <div class="pt-4">
                <dt class="text-[15.5px] font-semibold text-white tracking-[-0.01em]">
                  Verify Before Sharing
                </dt>
                <dd class="mt-1.5 text-[14.5px] leading-[1.58] text-[#A1A4AC]">
                  Test archive integrity without extracting and generate SHA-256 checksums beside your output.
                </dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Band 5: Supported Formats Directory -->
    <section id="formats" class="bg-[#F5F5F7] py-20 sm:py-28">
      <div class="max-w-[1160px] mx-auto px-6">
        <div class="max-w-[600px]">
          <h2
            class="text-[#111214] font-semibold tracking-[-0.03em] leading-[1.08]"
            style="font-size: clamp(30px, 3.4vw, 42px);"
          >
            One app for every archive you receive.
          </h2>
          <p class="mt-3.5 text-[17px] leading-[1.55] text-[#5B5E66]">
            Open, preview, verify, and build thirty-plus archive, disk image, comic, and package formats without extra tools.
          </p>
        </div>

        <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
          {FORMAT_DIRECTORY_GROUPS.map((group) => (
            <div class="border-t border-black/[0.10] pt-5">
              <h3 class="text-[16px] font-semibold text-[#111214] tracking-[-0.01em]">
                {group.category}
              </h3>
              <p class="mt-2.5 text-[15px] leading-[1.6] font-medium text-[#111214]">
                {group.formatsText}
              </p>
              <p class="mt-2 text-[14.5px] leading-[1.6] text-[#5B5E66]">
                {group.summary}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. Band 6: Closing Call to Action -->
    <section class="bg-white py-20 sm:py-28">
      <div class="max-w-[1160px] mx-auto px-6 flex flex-col items-start sm:items-center sm:text-center">
        <h2
          class="text-[#111214] font-semibold tracking-[-0.03em] leading-[1.08]"
          style="font-size: clamp(32px, 4vw, 46px);"
        >
          Ready when your Downloads folder isn&rsquo;t.
        </h2>
        <div class="mt-7 flex flex-wrap items-center gap-5">
          <a
            href={RELEASES_URL}
            data-dmg-link
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center h-11 px-6 rounded-full bg-[#111214] hover:bg-[#2A2C30] text-white text-[14.5px] font-medium tracking-[-0.01em] transition-colors"
          >
            Download for Mac
          </a>
          <a
            href={RELEASES_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[14.5px] font-medium text-[#5B5E66] hover:text-[#111214] transition-colors"
          >
            Release Notes &amp; SHA-256
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Minimal Footer -->
  <footer class="bg-white border-t border-black/[0.06]">
    <div class="max-w-[1160px] mx-auto px-6 py-7 flex flex-col sm:flex-row items-center justify-between gap-4 text-[13px] text-[#5B5E66]">
      <span class="font-medium text-[#111214]">BentoZip &mdash; Open source on GitHub (MIT)</span>
      <div class="flex items-center gap-6">
        <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer" class="hover:text-[#111214] transition-colors">
          Releases
        </a>
        <a href={ISSUES_URL} target="_blank" rel="noopener noreferrer" class="hover:text-[#111214] transition-colors">
          Issues
        </a>
        <span>Free on macOS 14+</span>
      </div>
    </div>
  </footer>

  <script>
    (() => {
      const apiUrl = 'https://api.github.com/repos/alikia2x/BentoZip/releases/latest';
      fetch(apiUrl, { headers: { Accept: 'application/vnd.github+json' } })
        .then((res) => (res.ok ? res.json() : null))
        .then((data) => {
          if (!data || !Array.isArray(data.assets)) return;
          const dmg = data.assets.find(
            (asset: { name?: string; browser_download_url?: string }) =>
              typeof asset.name === 'string' &&
              asset.name.toLowerCase().endsWith('.dmg') &&
              typeof asset.browser_download_url === 'string',
          );
          if (!dmg?.browser_download_url) return;
          document.querySelectorAll<HTMLAnchorElement>('a[data-dmg-link]').forEach((el) => {
            el.href = dmg.browser_download_url;
          });
        })
        .catch(() => {
          // Silently retain the fallback releases URL when offline or rate-limited.
        });
    })();
  </script>
</Layout>
