---
import Layout from '../layouts/Layout.astro';
import { FORMAT_DIRECTORY_GROUPS } from '../data/formats';

const RELEASES_URL = 'https://github.com/alikia2x/BentoZip/releases/latest';
const GITHUB_URL = 'https://github.com/alikia2x/BentoZip';
const ISSUES_URL = 'https://github.com/alikia2x/BentoZip/issues';
---

<Layout>
  <!-- Floating Minimal Navigation Capsule -->
  <div class="sticky top-3 z-50 px-4 sm:px-6 pt-3">
    <header class="max-w-[1160px] mx-auto h-13 px-4 sm:px-5 rounded-full bg-white/82 backdrop-blur-xl border border-black/[0.07] shadow-[0_6px_24px_rgba(20,20,18,0.06)] flex items-center justify-between gap-4">
      <a href="#" class="flex items-center gap-2.5 text-[#191816] no-underline shrink-0">
        <img
          src="/images/app-icon.png"
          alt="BentoZip"
          width="26"
          height="26"
          class="w-[26px] h-[26px] rounded-[6px] ring-1 ring-black/[0.06] shadow-[0_1px_3px_rgba(0,0,0,0.10)]"
        />
        <span class="text-[15px] font-semibold tracking-[-0.015em]">BentoZip</span>
      </a>

      <nav aria-label="Primary" class="flex items-center gap-5 sm:gap-7">
        <a
          href="#features"
          class="hidden sm:inline-block text-[13.5px] font-medium text-[#57544E] hover:text-[#191816] transition-colors"
        >
          Features
        </a>
        <a
          href="#formats"
          class="hidden sm:inline-block text-[13.5px] font-medium text-[#57544E] hover:text-[#191816] transition-colors"
        >
          Formats
        </a>
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[13.5px] font-medium text-[#57544E] hover:text-[#191816] transition-colors"
        >
          GitHub
        </a>
        <a
          href={RELEASES_URL}
          data-dmg-link
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center h-8 px-4 rounded-full bg-[#191816] hover:bg-[#32302C] text-white text-[13px] font-medium tracking-[-0.01em] transition-colors"
        >
          Download
        </a>
      </nav>
    </header>
  </div>

  <main>
    <!-- 1. Framed Editorial Hero -->
    <section class="max-w-[1200px] mx-auto px-4 sm:px-6 pt-5 sm:pt-7">
      <div class="rounded-[28px] sm:rounded-[34px] overflow-hidden border border-black/[0.07] bg-gradient-to-b from-[#EAF1F8] via-[#F2F5F9] to-[#EDEAE3] pt-10 sm:pt-14 px-5 sm:px-10 pb-8 sm:pb-12 shadow-[0_12px_40px_rgba(20,20,18,0.04)]">
        <div class="max-w-[860px] mx-auto text-center">
          <img
            src="/images/app-icon.png"
            alt="BentoZip app icon"
            width="64"
            height="64"
            class="w-[64px] h-[64px] mx-auto rounded-[15px] drop-shadow-[0_14px_26px_rgba(0,0,0,0.12)] mb-5"
          />

          <h1
            class="font-serif-editorial text-[#191816] font-normal tracking-[-0.025em] leading-[1.04]"
            style="font-size: clamp(38px, 4.8vw, 60px);"
          >
            Archives without the mess.
          </h1>

          <p class="mt-4 text-[17px] sm:text-[19px] leading-[1.52] text-[#55524C] max-w-[540px] mx-auto">
            Browse inside any archive like Finder, pull out a single file without unpacking the rest, and build clean encrypted archives across macOS.
          </p>

          <div class="mt-7 flex flex-wrap items-center justify-center gap-3.5">
            <a
              href={RELEASES_URL}
              data-dmg-link
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center h-11 px-6 rounded-full bg-[#191816] hover:bg-[#32302C] text-white text-[14.5px] font-medium tracking-[-0.01em] shadow-[0_8px_20px_rgba(25,24,22,0.16)] transition-all"
            >
              Download for Mac
            </a>
            <a
              href={GITHUB_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center h-11 px-5 rounded-full bg-white/75 hover:bg-white border border-black/[0.08] text-[#191816] text-[14.5px] font-medium tracking-[-0.01em] transition-colors"
            >
              View on GitHub
            </a>
          </div>

          <p class="mt-4 text-[13px] text-[#6B6760]">
            Free on macOS 14+ / Apple Silicon &amp; Intel / Signed &amp; Notarized
          </p>
        </div>

        <div class="mt-10 sm:mt-12 max-w-[1000px] mx-auto">
          <img
            src="/images/hero-browse.png"
            alt="BentoZip archive browser with Finder hierarchy and Info Inspector"
            width="1200"
            height="750"
            class="w-full h-auto block rounded-[18px] sm:rounded-[22px] border border-black/[0.07] shadow-[0_24px_60px_rgba(18,22,28,0.14)]"
          />
        </div>
      </div>
    </section>

    <!-- 2. Side-by-Side Feature Pair -->
    <section id="features" class="max-w-[1200px] mx-auto px-4 sm:px-6 pt-20 sm:pt-28 pb-10">
      <div class="max-w-[660px] mx-auto text-center">
        <h2
          class="font-serif-editorial text-[#191816] font-normal tracking-[-0.025em] leading-[1.08]"
          style="font-size: clamp(32px, 4vw, 48px);"
        >
          Open carefully. Pack cleanly.
        </h2>
        <p class="mt-3 text-[16.5px] sm:text-[17.5px] leading-[1.55] text-[#63605A]">
          Inspect, edit, and organize archives in one calm workspace instead of scattering folders across your Desktop.
        </p>
      </div>

      <div class="mt-10 sm:mt-12 grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Left Card: Browse, Preview, Edit -->
        <article class="bg-white rounded-[24px] border border-black/[0.07] p-6 sm:p-8 shadow-[0_8px_30px_rgba(20,20,18,0.04)] flex flex-col">
          <div class="overflow-hidden rounded-[14px] border border-black/[0.06] bg-[#ECE9E2] aspect-[16/11]">
            <img
              src="/images/feature-welcome.png"
              alt="BentoZip Welcome window with Recent archives sidebar"
              width="960"
              height="680"
              loading="lazy"
              class="w-full h-full object-cover object-center block"
            />
          </div>

          <h3 class="mt-7 font-serif-editorial text-[26px] sm:text-[28px] leading-[1.15] tracking-[-0.02em] text-[#191816]">
            Browse, preview, and edit inside.
          </h3>

          <p class="mt-2.5 text-[15.5px] leading-[1.6] text-[#55524C]">
            Explore archives in Finder lists or icon grids (⌘2), press Spacebar for Quick Look, inspect images and text inline, or flip through CBZ and CBR comics in a full image gallery.
          </p>

          <div class="mt-6 pt-5 border-t border-black/[0.07] space-y-3 text-[14.5px] leading-[1.55] text-[#55524C]">
            <p>
              <strong class="font-medium text-[#191816]">Drag out &amp; edit in place:</strong>
              Pull out a single file, drill into nested archives, or add, rename, move, and delete inside ZIP, 7z, and TAR — external edits save back automatically.
            </p>
            <p>
              <strong class="font-medium text-[#191816]">Clean international filenames:</strong>
              Legacy Windows ZIP archives in Chinese, Japanese, or Korean display cleanly on Mac with automatic encoding repair.
            </p>
          </div>
        </article>

        <!-- Right Card: Compress Inspector -->
        <article class="bg-white rounded-[24px] border border-black/[0.07] p-6 sm:p-8 shadow-[0_8px_30px_rgba(20,20,18,0.04)] flex flex-col">
          <div class="overflow-hidden rounded-[14px] border border-black/[0.06] bg-[#E8E9EC] aspect-[16/11]">
            <img
              src="/images/feature-compress.png"
              alt="BentoZip Compress mode with resizable Archive Settings inspector"
              width="1200"
              height="720"
              loading="lazy"
              class="w-full h-full object-cover object-center block"
            />
          </div>

          <h3 class="mt-7 font-serif-editorial text-[26px] sm:text-[28px] leading-[1.15] tracking-[-0.02em] text-[#191816]">
            Every packing control in one inspector.
          </h3>

          <p class="mt-2.5 text-[15.5px] leading-[1.6] text-[#55524C]">
            Save favorite settings as reusable presets, pack multiple items into separate archives or unpack several at once, and build compressed .dmg disk images.
          </p>

          <div class="mt-6 pt-5 border-t border-black/[0.07] space-y-3 text-[14.5px] leading-[1.55] text-[#55524C]">
            <p>
              <strong class="font-medium text-[#191816]">Encryption &amp; Touch ID vault:</strong>
              Protect ZIP archives with AES-256, lock 7z filenames, generate strong passwords, and store archive passwords safely in Keychain with Touch ID.
            </p>
            <p>
              <strong class="font-medium text-[#191816]">Mac-clean &amp; split archives:</strong>
              Automatically leave .DS_Store files and macOS clutter behind, or split oversized backups into multi-volume parts.
            </p>
          </div>
        </article>
      </div>
    </section>

    <!-- 3. Inset Dark Stage: Background Tasks & Finder Integration -->
    <section class="max-w-[1200px] mx-auto px-4 sm:px-6 py-10 sm:py-14">
      <div class="rounded-[28px] sm:rounded-[34px] bg-[#111215] text-[#F4F3EF] p-6 sm:p-10 lg:p-14 border border-black/[0.08] shadow-[0_20px_60px_rgba(17,18,21,0.14)]">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
          <div class="lg:col-span-7">
            <img
              src="/images/feature-tasks-dark.png"
              alt="BentoZip floating dark-mode Tasks window showing live speed and time remaining"
              width="1100"
              height="760"
              loading="lazy"
              class="w-full h-auto block rounded-[16px] sm:rounded-[20px] ring-1 ring-white/[0.1] shadow-[0_24px_60px_rgba(0,0,0,0.45)]"
            />
          </div>

          <div class="lg:col-span-5">
            <h2
              class="font-serif-editorial text-white font-normal tracking-[-0.025em] leading-[1.08]"
              style="font-size: clamp(30px, 3.6vw, 42px);"
            >
              Heavy work runs quietly in its own window.
            </h2>

            <p class="mt-4 text-[16px] leading-[1.6] text-[#A8A6A1]">
              Compressing large builds or unpacking multi-gigabyte archives never locks up your browser. Track live speed, progress, and time remaining in a dedicated floating Tasks window.
            </p>

            <dl class="mt-7 border-t border-white/[0.1] divide-y divide-white/[0.1]">
              <div class="py-4">
                <dt class="text-[15px] font-semibold text-white">
                  Integrated across Finder &amp; macOS
                </dt>
                <dd class="mt-1.5 text-[14.5px] leading-[1.58] text-[#A8A6A1]">
                  Preview archive contents directly from Finder Quick Look, compress or unpack from Finder right-click and Services, search archived filenames in Spotlight, or automate with Apple Shortcuts.
                </dd>
              </div>
              <div class="pt-4">
                <dt class="text-[15px] font-semibold text-white">
                  Fast re-open &amp; one-click safety
                </dt>
                <dd class="mt-1.5 text-[14.5px] leading-[1.58] text-[#A8A6A1]">
                  Re-open huge .tar.gz, .tar.bz2, .tar.xz, and .tar.zst archives rapidly, verify archive integrity with one click, and inspect file checksums whenever needed.
                </dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Clean Editorial Format Directory -->
    <section id="formats" class="max-w-[1200px] mx-auto px-4 sm:px-6 py-16 sm:py-24">
      <div class="max-w-[600px]">
        <h2
          class="font-serif-editorial text-[#191816] font-normal tracking-[-0.025em] leading-[1.08]"
          style="font-size: clamp(32px, 3.8vw, 44px);"
        >
          One app for every archive you receive.
        </h2>
        <p class="mt-3 text-[16.5px] leading-[1.55] text-[#63605A]">
          Open, preview, verify, and build thirty-plus archive, disk image, comic, and package formats in one place.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10">
        {FORMAT_DIRECTORY_GROUPS.map((group) => (
          <div class="pt-5 border-t border-black/[0.1]">
            <h3 class="text-[16px] font-semibold text-[#191816] tracking-[-0.01em]">
              {group.category}
            </h3>
            <p class="mt-3 text-[14.5px] leading-[1.65] font-medium text-[#2F2D29]">
              {group.formatsText}
            </p>
            <p class="mt-3 text-[14px] leading-[1.6] text-[#63605A]">
              {group.summary}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- 5. Quiet Closing CTA -->
    <section class="max-w-[1200px] mx-auto px-4 sm:px-6 pt-4 pb-20 sm:pb-24">
      <div class="border-t border-black/[0.08] pt-16 sm:pt-20 flex flex-col items-center text-center">
        <img
          src="/images/app-icon.png"
          alt="BentoZip"
          width="72"
          height="72"
          loading="lazy"
          class="w-[72px] h-[72px] rounded-[17px] drop-shadow-[0_14px_26px_rgba(0,0,0,0.12)] mb-6"
        />
        <h2
          class="font-serif-editorial text-[#191816] font-normal tracking-[-0.025em] leading-[1.08]"
          style="font-size: clamp(32px, 4.2vw, 48px);"
        >
          Built to belong on macOS.
        </h2>
        <div class="mt-7 flex flex-wrap items-center justify-center gap-3.5">
          <a
            href={RELEASES_URL}
            data-dmg-link
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center h-11 px-6 rounded-full bg-[#191816] hover:bg-[#32302C] text-white text-[14.5px] font-medium tracking-[-0.01em] shadow-[0_8px_20px_rgba(25,24,22,0.16)] transition-all"
          >
            Download for Mac
          </a>
          <a
            href={GITHUB_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center h-11 px-5 rounded-full bg-white hover:bg-[#FAF9F6] border border-black/[0.09] text-[#191816] text-[14.5px] font-medium tracking-[-0.01em] transition-colors"
          >
            View on GitHub
          </a>
        </div>
        <p class="mt-4 text-[13px] text-[#6B6760]">
          macOS 14+ / Universal (Apple Silicon &amp; Intel) / Signed &amp; Notarized
        </p>
      </div>
    </section>
  </main>

  <!-- Minimal Footer -->
  <footer class="max-w-[1200px] mx-auto px-4 sm:px-6 pb-8">
    <div class="border-t border-black/[0.08] pt-7 flex flex-col sm:flex-row items-center justify-between gap-4 text-[13px] text-[#6B6760]">
      <span class="font-medium text-[#191816]">BentoZip</span>
      <div class="flex items-center gap-6">
        <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer" class="hover:text-[#191816] transition-colors">
          Latest Release
        </a>
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="hover:text-[#191816] transition-colors">
          GitHub
        </a>
        <a href={ISSUES_URL} target="_blank" rel="noopener noreferrer" class="hover:text-[#191816] transition-colors">
          Issues
        </a>
      </div>
      <span>&copy; 2026 BentoZip</span>
    </div>
  </footer>

  <script>
    (() => {
      const apiUrl = 'https://api.github.com/repos/alikia2x/BentoZip/releases/latest';
      fetch(apiUrl, { headers: { Accept: 'application/vnd.github+json' } })
        .then((res) => (res.ok ? res.json() : null))
        .then((data) => {
          if (!data || !Array.isArray(data.assets)) return;
          const dmg = data.assets.find(
            (asset: { name?: string; browser_download_url?: string }) =>
              typeof asset.name === 'string' &&
              asset.name.toLowerCase().endsWith('.dmg') &&
              typeof asset.browser_download_url === 'string',
          );
          if (!dmg?.browser_download_url) return;
          document.querySelectorAll<HTMLAnchorElement>('a[data-dmg-link]').forEach((el) => {
            el.href = dmg.browser_download_url;
          });
        })
        .catch(() => {
          // Silently retain the fallback releases URL when offline or rate-limited.
        });
    })();
  </script>
</Layout>
