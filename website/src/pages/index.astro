---
import Layout from '../layouts/Layout.astro';

const GITHUB_URL = 'https://github.com/alikia2x/BentoZip';
const RELEASES_URL = 'https://github.com/alikia2x/BentoZip/releases/latest';
const ISSUES_URL = 'https://github.com/alikia2x/BentoZip/issues';
const FALLBACK_DMG_URL =
  'https://github.com/alikia2x/BentoZip/releases/download/v1.0.1/BentoZip-1.0.1-macos-universal.dmg';

let directDmgUrl = FALLBACK_DMG_URL;
let latestVersion = 'v1.0.1';

try {
  const res = await fetch('https://api.github.com/repos/alikia2x/BentoZip/releases/latest', {
    headers: { Accept: 'application/vnd.github+json' },
  });
  if (res.ok) {
    const data = await res.json();
    if (typeof data?.tag_name === 'string' && data.tag_name.length > 0) {
      latestVersion = data.tag_name;
    }
    if (Array.isArray(data?.assets)) {
      const dmg = data.assets.find(
        (asset: { name?: string; browser_download_url?: string }) =>
          typeof asset.name === 'string' &&
          asset.name.toLowerCase().endsWith('.dmg') &&
          typeof asset.browser_download_url === 'string',
      );
      if (dmg?.browser_download_url) {
        directDmgUrl = dmg.browser_download_url;
      }
    }
  }
} catch {
  // Use the baked release DMG URL if offline during build.
}

const CREATE_FORMATS = [
  'ZIP',
  '7z',
  'TAR',
  'TAR.GZ',
  'TAR.BZ2',
  'TAR.XZ',
  'TAR.ZST',
  'AAR',
  'DMG',
];

const EXTRACT_FORMATS = [
  'ZIP',
  '7z',
  'RAR',
  'TAR',
  'GZIP',
  'BZ2',
  'XZ',
  'ZSTD',
  'LZ4',
  'BROTLI',
  'LZMA',
  'AAR',
  'DMG',
  'ISO',
  'WIM',
  'SQUASHFS',
  'VMDK',
  'CHM',
  'XAR',
  'PKG',
  'CPIO',
  'LZH',
  'CAB',
  'ARJ',
  'DEB',
  'RPM',
  'CBZ',
  'CBR',
  'EPUB',
];
---

<Layout>
  <!-- Navigation -->
  <header class="sticky top-0 z-50 border-b border-white/[0.07] bg-[#08090C]/80 backdrop-blur-xl">
    <div class="max-w-[1140px] mx-auto px-6 h-14 flex items-center justify-between gap-6">
      <a href="#" class="flex items-center gap-2.5 text-white no-underline shrink-0">
        <img
          src="/images/app-icon.png"
          alt="BentoZip"
          width="24"
          height="24"
          class="w-6 h-6 rounded-[6px] ring-1 ring-white/[0.14]"
        />
        <span class="text-[15px] font-semibold tracking-[-0.015em]">BentoZip</span>
      </a>

      <nav aria-label="Primary" class="flex items-center gap-6 sm:gap-8">
        <a
          href="#compression"
          class="hidden sm:inline-block text-[13.5px] font-medium text-[#8E939E] hover:text-white transition-colors"
        >
          Packaging
        </a>
        <a
          href="#transfers"
          class="hidden sm:inline-block text-[13.5px] font-medium text-[#8E939E] hover:text-white transition-colors"
        >
          Transfers
        </a>
        <a
          href="#formats"
          class="hidden sm:inline-block text-[13.5px] font-medium text-[#8E939E] hover:text-white transition-colors"
        >
          Formats
        </a>
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[13.5px] font-medium text-[#8E939E] hover:text-white transition-colors"
        >
          GitHub
        </a>
        <a
          href={directDmgUrl}
          data-dmg-link
          download
          class="inline-flex items-center justify-center h-8 px-4 rounded-full bg-white hover:bg-[#E4E4E7] text-[#08090C] text-[13px] font-medium transition-colors"
        >
          Download
        </a>
      </nav>
    </div>
  </header>

  <main class="relative">
    <!-- Hero -->
    <section class="relative overflow-hidden pt-10 sm:pt-12 pb-12 sm:pb-16">
      <div class="pointer-events-none absolute inset-x-0 top-0 h-[540px] hero-glow"></div>

      <div class="relative max-w-[1140px] mx-auto px-6">
        <div class="max-w-[700px]">
          <h1
            class="text-white font-semibold tracking-[-0.03em] leading-[1.06]"
            style="font-size: clamp(36px, 4.4vw, 54px);"
          >
            Open, edit, and pack archives on Mac
          </h1>

          <p class="mt-3.5 text-[17px] leading-[1.55] text-[#9CA3AF] max-w-[540px]">
            Browse inside archives like Finder, extract individual files, and track concurrent compressions and extractions in a floating queue.
          </p>

          <div class="mt-6 flex flex-wrap items-center gap-3.5">
            <a
              href={directDmgUrl}
              data-dmg-link
              download
              class="inline-flex items-center justify-center h-10 px-5 rounded-full bg-white hover:bg-[#E4E4E7] text-[#08090C] text-[14px] font-medium transition-colors"
            >
              Download for Mac
            </a>
            <a
              href={GITHUB_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center h-10 px-5 rounded-full bg-white/[0.06] hover:bg-white/[0.11] text-white text-[14px] font-medium border border-white/[0.09] transition-colors"
            >
              GitHub
            </a>
            <span class="text-[13px] text-[#71717A] sm:ml-1.5">
              Free for macOS 14+ ({latestVersion})
            </span>
          </div>
        </div>

        <div class="mt-8 relative">
          <div class="hero-window-fade">
            <img
              src="/images/window-tasks-dark.png"
              alt="BentoZip archive browser showing file listing alongside the floating Tasks progress window"
              width="1980"
              height="1250"
              class="w-full h-auto block drop-shadow-[0_24px_70px_rgba(0,0,0,0.65)]"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Create & Encrypt -->
    <section id="compression" class="py-20 sm:py-24 border-t border-white/[0.06]">
      <div class="max-w-[1140px] mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <div class="lg:col-span-8">
          <div class="rounded-[18px] bg-[#12141A] border border-white/[0.09] p-3 sm:p-5">
            <div class="rounded-[10px] overflow-hidden shadow-[0_24px_60px_rgba(0,0,0,0.45)] brightness-[0.96]">
              <img
                src="/images/window-compress.png"
                alt="BentoZip compression panel showing ZIP format, AES-256 encryption, 500 MB split volumes, and .DS_Store exclusion filters"
                width="2100"
                height="1292"
                loading="lazy"
                class="w-full h-auto block"
              />
            </div>
          </div>
        </div>

        <div class="lg:col-span-4 space-y-3.5">
          <h2
            class="text-white font-semibold tracking-[-0.025em] leading-[1.12]"
            style="font-size: clamp(26px, 2.8vw, 34px);"
          >
            Create encrypted and split archives
          </h2>
          <p class="text-[16px] leading-[1.6] text-[#9CA3AF]">
            Choose format and compression level, set AES-256 passwords, split large builds by volume size, and exclude files such as .DS_Store or build artifacts in the inspector.
          </p>
        </div>
      </div>
    </section>

    <!-- Transfer Progress -->
    <section id="transfers" class="py-20 sm:py-24 border-t border-white/[0.06]">
      <div class="max-w-[1140px] mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <div class="lg:col-span-6 space-y-3.5">
          <h2
            class="text-white font-semibold tracking-[-0.025em] leading-[1.12]"
            style="font-size: clamp(26px, 3vw, 36px);"
          >
            Live progress for concurrent tasks
          </h2>
          <p class="text-[16px] leading-[1.6] text-[#9CA3AF] max-w-[470px]">
            Monitor throughput, elapsed and remaining time, processed byte counts, and compression savings across active jobs in a dedicated Tasks window without blocking browsing.
          </p>
        </div>

        <div class="lg:col-span-6 flex lg:justify-end">
          <div class="w-full max-w-[460px] rounded-[12px] ring-1 ring-white/[0.12] overflow-hidden shadow-[0_28px_64px_rgba(0,0,0,0.55)]">
            <img
              src="/images/window-tasks-hud.png"
              alt="BentoZip floating Tasks window displaying transfer speed, elapsed time, processed bytes, and compression ratio"
              width="920"
              height="667"
              loading="lazy"
              class="w-full h-auto block"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Formats Matrix -->
    <section id="formats" class="py-20 sm:py-24 border-t border-white/[0.06]">
      <div class="max-w-[1140px] mx-auto px-6 text-center space-y-12">
        <div class="space-y-6">
          <h2 class="text-[17px] font-medium text-[#A1A1AA]">
            Create and edit these formats
          </h2>
          <div class="flex flex-wrap items-center justify-center gap-x-7 gap-y-3.5 max-w-[780px] mx-auto text-[14.5px] font-medium tracking-[0.04em] text-[#E4E4E7]">
            {CREATE_FORMATS.map((fmt) => (
              <span>{fmt}</span>
            ))}
          </div>
        </div>

        <div class="space-y-6 pt-2">
          <h2 class="text-[17px] font-medium text-[#A1A1AA]">
            Extract and inspect all of these formats
          </h2>
          <div class="flex flex-wrap items-center justify-center gap-x-7 gap-y-3.5 max-w-[920px] mx-auto text-[14.5px] font-medium tracking-[0.04em] text-[#D4D4D8]">
            {EXTRACT_FORMATS.map((fmt) => (
              <span>{fmt}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Closing CTA -->
    <section class="py-20 sm:py-24 border-t border-white/[0.06]">
      <div class="max-w-[1140px] mx-auto px-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
        <div>
          <h2
            class="text-white font-semibold tracking-[-0.025em] leading-[1.12]"
            style="font-size: clamp(28px, 3.2vw, 38px);"
          >
            Download BentoZip
          </h2>
          <p class="mt-2 text-[15.5px] text-[#8E939E]">
            Universal Mac disk image for Apple Silicon and Intel, signed and notarized with Apple.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-4 shrink-0">
          <a
            href={directDmgUrl}
            data-dmg-link
            download
            class="inline-flex items-center justify-center h-11 px-6 rounded-full bg-white hover:bg-[#E4E4E7] text-[#08090C] text-[14.5px] font-medium transition-colors"
          >
            Download .dmg
          </a>
          <a
            href={RELEASES_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[14px] font-medium text-[#8E939E] hover:text-white transition-colors"
          >
            Release notes
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-white/[0.06]">
    <div class="max-w-[1140px] mx-auto px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[13px] text-[#71717A]">
      <span class="font-medium text-[#D4D4D8]">BentoZip</span>
      <div class="flex items-center gap-6">
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          GitHub
        </a>
        <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          Releases
        </a>
        <a href={ISSUES_URL} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          Issues
        </a>
      </div>
    </div>
  </footer>

  <script>
    (() => {
      const apiUrl = 'https://api.github.com/repos/alikia2x/BentoZip/releases/latest';
      fetch(apiUrl, { headers: { Accept: 'application/vnd.github+json' } })
        .then((res) => (res.ok ? res.json() : null))
        .then((data) => {
          if (!data || !Array.isArray(data.assets)) return;
          const dmg = data.assets.find(
            (asset: { name?: string; browser_download_url?: string }) =>
              typeof asset.name === 'string' &&
              asset.name.toLowerCase().endsWith('.dmg') &&
              typeof asset.browser_download_url === 'string',
          );
          if (!dmg?.browser_download_url) return;
          document.querySelectorAll<HTMLAnchorElement>('a[data-dmg-link]').forEach((el) => {
            el.href = dmg.browser_download_url;
          });
        })
        .catch(() => {
          // Retain the build-time DMG URL when offline or rate-limited.
        });
    })();
  </script>
</Layout>
