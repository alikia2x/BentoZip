---
import Layout from '../layouts/Layout.astro';
import DownloadWidget from '../components/DownloadWidget';
import WorkspaceShowcase from '../components/WorkspaceShowcase';
import MacEcosystem from '../components/MacEcosystem';
import FormatMatrix from '../components/FormatMatrix';
import {
  Archive,
  Cpu,
  FolderSync,
  Layers,
  Languages,
  ShieldCheck,
} from 'lucide-react';

const RELEASES_URL = 'https://github.com/alikia2x/BentoZip/releases/latest';
const GITHUB_URL = 'https://github.com/alikia2x/BentoZip';
const CHANGELOG_URL = 'https://github.com/alikia2x/BentoZip/blob/main/CHANGELOG.md';
const ISSUES_URL = 'https://github.com/alikia2x/BentoZip/issues';
---

<Layout>
  <!-- Sticky Translucent Studio Header -->
  <header class="sticky top-0 z-50 h-14 bg-[#0A0B0E]/82 backdrop-blur-xl border-b border-white/[0.08]">
    <div class="max-w-[1180px] mx-auto h-full px-5 sm:px-8 flex items-center justify-between gap-4">
      <a href="#" class="flex items-center gap-2.5 text-white no-underline group shrink-0">
        <img
          src="/images/app-icon.png"
          alt="BentoZip"
          width="26"
          height="26"
          class="w-[26px] h-[26px] rounded-[6px] ring-1 ring-white/15 shadow-sm"
        />
        <span class="text-[15px] font-semibold tracking-[-0.015em]">BentoZip</span>
      </a>

      <nav aria-label="Primary" class="flex items-center gap-5 sm:gap-7">
        <a
          href="#workspace"
          class="hidden md:inline-block text-[13.5px] font-medium text-[#A1A1A6] hover:text-white transition-colors"
        >
          Workspace
        </a>
        <a
          href="#engine"
          class="hidden md:inline-block text-[13.5px] font-medium text-[#A1A1A6] hover:text-white transition-colors"
        >
          Engine
        </a>
        <a
          href="#macos"
          class="hidden sm:inline-block text-[13.5px] font-medium text-[#A1A1A6] hover:text-white transition-colors"
        >
          macOS
        </a>
        <a
          href="#formats"
          class="hidden sm:inline-block text-[13.5px] font-medium text-[#A1A1A6] hover:text-white transition-colors"
        >
          Formats
        </a>
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[13.5px] font-medium text-[#A1A1A6] hover:text-white transition-colors"
        >
          GitHub
        </a>
        <a
          href={RELEASES_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center h-8 px-4 rounded-full bg-white text-[#0A0B0E] hover:bg-[#E5E5EA] text-[13px] font-semibold tracking-[-0.01em] transition-colors"
        >
          Download
        </a>
      </nav>
    </div>
  </header>

  <main>
    <!-- 1. Obsidian Studio Hero -->
    <section class="relative overflow-hidden bg-[#0A0B0E] bg-studio-grid-dark pt-16 sm:pt-24 pb-20 sm:pb-28 border-b border-white/[0.08]">
      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-[520px] opacity-60"
        style="background: radial-gradient(65% 60% at 50% 0%, rgba(10, 132, 255, 0.16) 0%, rgba(10, 11, 14, 0) 100%);"
        aria-hidden="true"
      ></div>

      <div class="relative max-w-[1180px] mx-auto px-5 sm:px-8">
        <div class="flex flex-col items-center text-center">
          <img
            src="/images/app-icon.png"
            alt="BentoZip macOS app icon"
            width="80"
            height="80"
            class="w-[78px] h-[78px] rounded-[18px] shadow-[0_24px_48px_rgba(0,0,0,0.6)] ring-1 ring-white/15 mb-7"
          />

          <h1
            class="text-white font-semibold tracking-[-0.04em] leading-[1.03] max-w-[780px]"
            style="font-size: clamp(34px, 6.2vw, 74px);"
          >
            Archives, the Mac way.
          </h1>

          <p class="mt-5 text-[18px] sm:text-[20px] leading-[1.5] text-[#A1A1A6] max-w-[630px] font-normal tracking-[-0.012em]">
            Browse any archive like Finder, drag out individual files without unpacking the rest, edit ZIP, 7z, and TAR in place, and automate workflows from Shortcuts or Terminal.
          </p>

          <div class="mt-8">
            <DownloadWidget client:load variant="hero" />
          </div>

          <div class="mt-7 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-[12.5px] text-[#8E8E93]">
            <span>Signed &amp; Notarized DMG</span>
            <span class="text-white/20" aria-hidden="true">/</span>
            <span>Zero Cloud · Zero Telemetry</span>
            <span class="text-white/20" aria-hidden="true">/</span>
            <span>Free &amp; Open Source</span>
          </div>
        </div>

        <!-- Hero Window Showcase -->
        <div class="mt-14 sm:mt-16 rounded-[24px] sm:rounded-[30px] p-2 sm:p-3 bg-white/[0.04] border border-white/[0.1] shadow-[0_40px_100px_rgba(0,0,0,0.7)]">
          <img
            src="/images/hero-browse.png"
            alt="BentoZip archive browser showing Finder-style hierarchy and Info Inspector for Design-System-v4.2.tar.gz"
            width="1200"
            height="750"
            class="w-full h-auto block rounded-[18px] sm:rounded-[22px]"
          />
        </div>
      </div>
    </section>

    <!-- 2. Interactive Workspace Showcase (Light Studio Band) -->
    <section id="workspace" class="bg-white text-[#1D1D1F] py-24 sm:py-32">
      <div class="max-w-[1180px] mx-auto px-5 sm:px-8">
        <div class="max-w-[660px] mx-auto text-center">
          <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-[#0071E3] font-semibold">
            Native AppKit + SwiftUI Workspace
          </p>
          <h2
            class="mt-3 text-[#1D1D1F] font-semibold tracking-[-0.035em] leading-[1.06]"
            style="font-size: clamp(32px, 4vw, 48px);"
          >
            Four workflows. One coherent window.
          </h2>
          <p class="mt-4 text-[17px] leading-[1.55] text-[#515154]">
            Switch between archive browsing, compression presets, live background transfer telemetry, and your Touch ID password vault.
          </p>
        </div>

        <WorkspaceShowcase client:visible />
      </div>
    </section>

    <!-- 3. Engine & Architecture Bento Grid (Stone Studio Band) -->
    <section id="engine" class="bg-[#F5F5F7] bg-studio-grid-light text-[#1D1D1F] py-24 sm:py-32 border-y border-black/[0.06]">
      <div class="max-w-[1180px] mx-auto px-5 sm:px-8">
        <div class="max-w-[640px]">
          <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-[#0071E3] font-semibold">
            Architecture &amp; Craft
          </p>
          <h2
            class="mt-3 text-[#1D1D1F] font-semibold tracking-[-0.035em] leading-[1.06]"
            style="font-size: clamp(32px, 4vw, 46px);"
          >
            Engineered around native macOS primitives.
          </h2>
          <p class="mt-4 text-[17px] leading-[1.55] text-[#515154]">
            Built on a persistent C++17 engine over Unix domain sockets, paired with Apple Archive and AppKit performance where it matters.
          </p>
        </div>

        <!-- Asymmetric Architectural Bento Grid -->
        <div class="mt-12 grid grid-cols-1 md:grid-cols-12 gap-5">
          <!-- Card 1 (7 cols) -->
          <article class="md:col-span-7 rounded-[24px] bg-white border border-black/[0.08] p-7 sm:p-8 flex flex-col justify-between shadow-[0_8px_24px_rgba(0,0,0,0.03)]">
            <div>
              <div class="flex items-center justify-between gap-3">
                <div class="w-10 h-10 rounded-xl bg-[#F5F5F7] border border-black/[0.06] flex items-center justify-center text-[#1D1D1F]">
                  <Cpu className="w-5 h-5" />
                </div>
                <span class="font-mono text-[11.5px] text-[#6E6E73] bg-[#F5F5F7] px-2.5 py-1 rounded-md border border-black/[0.06]">
                  bento7z --server · Unix Socket
                </span>
              </div>
              <h3 class="mt-5 text-[21px] font-semibold tracking-[-0.02em] text-[#1D1D1F]">
                Persistent interactive worker, isolated heavy I/O
              </h3>
              <p class="mt-2.5 text-[15px] leading-[1.6] text-[#515154]">
                BentoZip routes quick directory listings through a persistent Unix-socket worker while isolating long compressions and extractions in separate processes, with automatic JSONL stdio fallback.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-black/[0.06] flex flex-wrap gap-2 font-mono text-[11.5px] text-[#515154]">
              <span class="px-2.5 py-1 rounded-md bg-[#F5F5F7]">O(1) FileNode Tree</span>
              <span class="px-2.5 py-1 rounded-md bg-[#F5F5F7]">512 MB–4 GB .tar.* Cache</span>
              <span class="px-2.5 py-1 rounded-md bg-[#F5F5F7]">AppleArchive (.aar)</span>
            </div>
          </article>

          <!-- Card 2 (5 cols) -->
          <article class="md:col-span-5 rounded-[24px] bg-white border border-black/[0.08] p-7 sm:p-8 flex flex-col justify-between shadow-[0_8px_24px_rgba(0,0,0,0.03)]">
            <div>
              <div class="flex items-center justify-between gap-3">
                <div class="w-10 h-10 rounded-xl bg-[#F5F5F7] border border-black/[0.06] flex items-center justify-center text-[#1D1D1F]">
                  <Archive className="w-5 h-5" />
                </div>
                <span class="font-mono text-[11.5px] text-[#6E6E73] bg-[#F5F5F7] px-2.5 py-1 rounded-md border border-black/[0.06]">
                  ZIP · 7z · TAR
                </span>
              </div>
              <h3 class="mt-5 text-[21px] font-semibold tracking-[-0.02em] text-[#1D1D1F]">
                Edit archives in place
              </h3>
              <p class="mt-2.5 text-[15px] leading-[1.6] text-[#515154]">
                Drop new files in, rename entries, create folders, or press Delete to prune clutter inside ZIP, 7z, and TAR archives without recompressing everything from scratch.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-black/[0.06] font-mono text-[11.5px] text-[#515154]">
              Atomic rebuild fallback for solid 7z &amp; .tar.* streams
            </div>
          </article>

          <!-- Card 3 (5 cols) -->
          <article class="md:col-span-5 rounded-[24px] bg-white border border-black/[0.08] p-7 sm:p-8 flex flex-col justify-between shadow-[0_8px_24px_rgba(0,0,0,0.03)]">
            <div>
              <div class="flex items-center justify-between gap-3">
                <div class="w-10 h-10 rounded-xl bg-[#F5F5F7] border border-black/[0.06] flex items-center justify-center text-[#1D1D1F]">
                  <Layers className="w-5 h-5" />
                </div>
                <span class="font-mono text-[11.5px] text-[#6E6E73] bg-[#F5F5F7] px-2.5 py-1 rounded-md border border-black/[0.06]">
                  Live Save-Back
                </span>
              </div>
              <h3 class="mt-5 text-[21px] font-semibold tracking-[-0.02em] text-[#1D1D1F]">
                Nested drill-down &amp; external editing
              </h3>
              <p class="mt-2.5 text-[15px] leading-[1.6] text-[#515154]">
                Double-click archives nested inside archives to step deeper with breadcrumbs. Open a file in an external editor, save your changes, and BentoZip packs the updated file back into writable archives.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-black/[0.06] font-mono text-[11.5px] text-[#515154]">
              NSFilePromiseProvider lazy single-file drag-out
            </div>
          </article>

          <!-- Card 4 (7 cols) -->
          <article class="md:col-span-7 rounded-[24px] bg-white border border-black/[0.08] p-7 sm:p-8 flex flex-col justify-between shadow-[0_8px_24px_rgba(0,0,0,0.03)]">
            <div>
              <div class="flex items-center justify-between gap-3">
                <div class="w-10 h-10 rounded-xl bg-[#F5F5F7] border border-black/[0.06] flex items-center justify-center text-[#1D1D1F]">
                  <Languages className="w-5 h-5" />
                </div>
                <span class="font-mono text-[11.5px] text-[#6E6E73] bg-[#F5F5F7] px-2.5 py-1 rounded-md border border-black/[0.06]">
                  GBK · Big5 · Shift-JIS
                </span>
              </div>
              <h3 class="mt-5 text-[21px] font-semibold tracking-[-0.02em] text-[#1D1D1F]">
                Automatic CJK legacy ZIP filename repair
              </h3>
              <p class="mt-2.5 text-[15px] leading-[1.6] text-[#515154]">
                Archives built on older Windows machines often turn Chinese or Japanese filenames into garbled mojibake on macOS. BentoZip detects non-UTF-8 codepages and converts entry paths via iconv during both browsing and extraction.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-black/[0.06] flex flex-wrap gap-2 font-mono text-[11.5px] text-[#515154]">
              <span class="px-2.5 py-1 rounded-md bg-[#F5F5F7]">Zero manual encoding picker</span>
              <span class="px-2.5 py-1 rounded-md bg-[#F5F5F7]">Preserved across browse &amp; extract</span>
            </div>
          </article>

          <!-- Card 5 (5 cols) -->
          <article class="md:col-span-5 rounded-[24px] bg-white border border-black/[0.08] p-7 sm:p-8 flex flex-col justify-between shadow-[0_8px_24px_rgba(0,0,0,0.03)]">
            <div>
              <div class="flex items-center justify-between gap-3">
                <div class="w-10 h-10 rounded-xl bg-[#F5F5F7] border border-black/[0.06] flex items-center justify-center text-[#1D1D1F]">
                  <ShieldCheck className="w-5 h-5" />
                </div>
                <span className="font-mono text-[11.5px] text-[#6E6E73] bg-[#F5F5F7] px-2.5 py-1 rounded-md border border-black/[0.06]">
                  SHA-256 · MD5
                </span>
              </div>
              <h3 class="mt-5 text-[21px] font-semibold tracking-[-0.02em] text-[#1D1D1F]">
                Verification, path safety &amp; quarantine control
              </h3>
              <p class="mt-2.5 text-[15px] leading-[1.6] text-[#515154]">
                Inspect streaming SHA-256 and MD5 checksums, block Zip-Slip path traversal segments automatically, and strip <code class="font-mono text-[13px] bg-[#F5F5F7] px-1.5 py-0.5 rounded">com.apple.quarantine</code> attributes on trusted extractions when enabled.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-black/[0.06] font-mono text-[11.5px] text-[#515154]">
              Single-folder auto-unwrap &amp; CRC32 column support
            </div>
          </article>

          <!-- Card 6 (7 cols with Welcome screenshot) -->
          <article class="md:col-span-7 rounded-[24px] bg-white border border-black/[0.08] p-7 sm:p-8 grid grid-cols-1 sm:grid-cols-12 gap-6 items-center shadow-[0_8px_24px_rgba(0,0,0,0.03)]">
            <div class="sm:col-span-5">
              <div class="w-10 h-10 rounded-xl bg-[#F5F5F7] border border-black/[0.06] flex items-center justify-center text-[#1D1D1F]">
                <FolderSync className="w-5 h-5" />
              </div>
              <h3 class="mt-5 text-[20px] font-semibold tracking-[-0.02em] text-[#1D1D1F]">
                Document-native multi-window flow
              </h3>
              <p class="mt-2.5 text-[14.5px] leading-[1.6] text-[#515154]">
                Every archive opens in its own window with proxy icons, duplicate-window deduplication, recent archives history, and Finder drag-in drop targets.
              </p>
            </div>
            <div class="sm:col-span-7 rounded-[16px] overflow-hidden border border-black/[0.08] shadow-[0_14px_34px_rgba(0,0,0,0.09)]">
              <img
                src="/images/feature-welcome.png"
                alt="BentoZip Welcome window with Recent archives sidebar"
                width="960"
                height="680"
                loading="lazy"
                class="w-full h-auto block"
              />
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- 4. macOS Ecosystem & Automation (Obsidian Studio Band) -->
    <section id="macos" class="bg-[#0B0C0F] text-white py-24 sm:py-32 border-b border-white/[0.08]">
      <div class="max-w-[1180px] mx-auto px-5 sm:px-8">
        <div class="max-w-[660px]">
          <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-[#409CFF] font-semibold">
            System Integration &amp; Automation
          </p>
          <h2
            class="mt-3 text-white font-semibold tracking-[-0.035em] leading-[1.06]"
            style="font-size: clamp(32px, 4vw, 46px);"
          >
            Deeply wired into macOS.
          </h2>
          <p class="mt-4 text-[17px] leading-[1.55] text-[#A1A1A6]">
            Use BentoZip directly inside Finder, Spotlight, Quick Look, Apple Shortcuts, or Terminal—without changing how you work.
          </p>
        </div>

        <MacEcosystem client:visible />
      </div>
    </section>

    <!-- 5. Searchable Format Matrix (Crisp Light Band) -->
    <section id="formats" class="bg-white text-[#1D1D1F] py-24 sm:py-32">
      <div class="max-w-[1180px] mx-auto px-5 sm:px-8">
        <div class="max-w-[640px]">
          <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-[#0071E3] font-semibold">
            Format Directory
          </p>
          <h2
            class="mt-3 text-[#1D1D1F] font-semibold tracking-[-0.035em] leading-[1.06]"
            style="font-size: clamp(32px, 4vw, 46px);"
          >
            36 formats. One consistent inspector.
          </h2>
          <p class="mt-4 text-[17px] leading-[1.55] text-[#515154]">
            Detected by compound extension and magic bytes—from encrypted ZIP and 7z splits to Apple Archives, disk images, Linux packages, and comic bundles.
          </p>
        </div>

        <FormatMatrix client:visible />
      </div>
    </section>

    <!-- 6. Closing CTA (Obsidian Studio Band) -->
    <section class="relative overflow-hidden bg-[#0A0B0E] bg-studio-grid-dark text-white py-24 sm:py-32 border-t border-white/[0.08]">
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-[360px] opacity-60"
        style="background: radial-gradient(55% 70% at 50% 100%, rgba(10, 132, 255, 0.14) 0%, rgba(10, 11, 14, 0) 100%);"
        aria-hidden="true"
      ></div>

      <div class="relative max-w-[1180px] mx-auto px-5 sm:px-8 flex flex-col items-center text-center">
        <img
          src="/images/app-icon.png"
          alt="BentoZip"
          width="84"
          height="84"
          loading="lazy"
          class="w-[84px] h-[84px] rounded-[20px] shadow-[0_24px_48px_rgba(0,0,0,0.6)] ring-1 ring-white/15 mb-7"
        />
        <h2
          class="text-white font-semibold tracking-[-0.038em] leading-[1.05] max-w-[660px]"
          style="font-size: clamp(34px, 4.6vw, 54px);"
        >
          Built to belong on macOS.
        </h2>
        <p class="mt-4 text-[17px] leading-[1.55] text-[#A1A1A6] max-w-[500px]">
          Download the universal notarized disk image or inspect the source directly on GitHub.
        </p>

        <div class="mt-8">
          <DownloadWidget client:load variant="compact" />
        </div>
      </div>
    </section>
  </main>

  <!-- Minimal Studio Footer -->
  <footer class="bg-[#0A0B0E] border-t border-white/[0.08]">
    <div class="max-w-[1180px] mx-auto px-5 sm:px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[13px] text-[#8E8E93]">
      <div class="flex items-center gap-2.5">
        <span class="font-semibold text-white">BentoZip</span>
        <span class="text-white/20" aria-hidden="true">·</span>
        <span>Native Archive Studio for macOS</span>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-6">
        <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          Releases
        </a>
        <a href={CHANGELOG_URL} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          Changelog
        </a>
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          GitHub
        </a>
        <a href={ISSUES_URL} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          Issues
        </a>
      </div>

      <span>&copy; 2026 BentoZip</span>
    </div>
  </footer>
</Layout>
