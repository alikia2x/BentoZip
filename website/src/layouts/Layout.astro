---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'BentoZip — Native Archive Studio for macOS',
  description = 'Browse inside any archive like Finder, pull out single files lazily, edit ZIP, 7z, and TAR in place, and automate workflows with Shortcuts and CLI.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/hero-browse.png" />
    <meta name="theme-color" content="#0A0B0E" />
  </head>
  <body class="bg-[#0A0B0E] text-[#F5F5F7] antialiased selection:bg-[#0A84FF]/25 selection:text-white">
    <slot />
  </body>
</html>
