---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'BentoZip — Fast archive manager for macOS',
  description = 'Browse inside compressed folders before unpacking, extract single files cleanly, and build encrypted releases on macOS.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/feature-tasks-dark.png" />
    <meta name="theme-color" content="#08090C" />
  </head>
  <body class="bg-[#08090C] text-[#F4F4F6] antialiased selection:bg-[#3B82F6]/30 selection:text-white">
    <slot />
  </body>
</html>
