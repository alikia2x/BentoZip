---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'BentoZip — Native macOS Archive Manager',
  description = 'Browse inside archives like Finder, drag out single files, press Space for Quick Look, and pack with AES-256 encryption.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/hero-workspace.png" />
    <meta name="theme-color" content="#FAFAF8" />
  </head>
  <body class="bg-[#FAFAF8] text-[#111113] antialiased selection:bg-[#0071E3]/15 selection:text-[#111113]">
    <slot />
  </body>
</html>
